# Settings for the benchmark stack (compose.phase1.yml). Nothing here is a real credential.
# Mounted at /run/bench.env and selected with APP_ENV_FILE; backend/app/.env is never read.

ENVIRONMENT=local
EXTERNAL_SERVICES=fake
DOMAIN=localhost
CORS_ORIGINS=[]

POSTGRESQL_SERVER=db
POSTGRESQL_PORT=5432
POSTGRESQL_USERNAME=chatbot_bench
POSTGRESQL_PASSWORD=chatbot_bench
POSTGRESQL_DATABASE=chatbot_bench
REDIS_URL=redis://redis:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
ID_STRATEGY=random

JWT_SECRET_KEY=bench-only-secret-not-for-production-0123456789
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassw0rd!

MISTRAL_API_KEY=bench-not-a-real-key
COHERE_API_KEY=bench-not-a-real-key
PINECONE_API=bench-not-a-real-key
JIRA_API_TOKEN=bench-not-a-real-key
VECTOR_STORE_PROVIDER=pinecone

SEARCH_PROVIDER=none
SUGGESTIONS_ENABLED=false

JIRA_DOMAIN=jira.example.com
JIRA_EMAIL=bot@example.com
JIRA_PROJECT_KEY=BENCH
JIRA_ISSUE_TYPE=Bug
BUG_REPORT_RATE_LIMIT_SECONDS=3600

CHAT_DAILY_LIMIT_PER_USER=0
REGISTRATION_MAX_GLOBAL=1000000
FAKE_LLM_TOKEN_COUNT=40
FAKE_LLM_TOKEN_DELAY_MS=20
TRUST_PROXY_HEADERS=false

# Argon2 settings are left out on purpose: production defaults apply.
