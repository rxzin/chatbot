# Settings for the automated tests. Nothing here is a real credential.
# conftest.py points APP_ENV_FILE at this file, so backend/app/.env is never read.

ENVIRONMENT=local
EXTERNAL_SERVICES=fake
DOMAIN=localhost
CORS_ORIGINS=[]

# docker-compose.test.yml
POSTGRESQL_SERVER=127.0.0.1
POSTGRESQL_PORT=55432
POSTGRESQL_USERNAME=chatbot_test
POSTGRESQL_PASSWORD=chatbot_test
POSTGRESQL_DATABASE=chatbot_test
REDIS_URL=redis://127.0.0.1:56379/0

JWT_SECRET_KEY=test-only-secret-not-for-production-0123456789
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPassw0rd!

MISTRAL_API_KEY=test-not-a-real-key
COHERE_API_KEY=test-not-a-real-key
PINECONE_API=test-not-a-real-key
JIRA_API_TOKEN=test-not-a-real-key
VECTOR_STORE_PROVIDER=pinecone

SEARCH_PROVIDER=none
SUGGESTIONS_ENABLED=false

JIRA_DOMAIN=jira.example.com
JIRA_EMAIL=bot@example.com
JIRA_PROJECT_KEY=TEST
JIRA_ISSUE_TYPE=Bug
BUG_REPORT_RATE_LIMIT_SECONDS=3600
